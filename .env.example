# Optional but strongly recommended. A GitHub personal access token (no scopes
# needed for public repositories) raises the GitHub API rate limit from 60 to
# 5,000 requests/hour and lets Welwitschia analyze a much larger sample of
# each repository's commit history.
GITHUB_TOKEN=

# Optional. Enables the "Explain This Period" button, which sends a small
# summarized JSON payload (not source code or full commit data) to the
# Anthropic API for a plain-English explanation. The rest of the app works
# fully without this key.
ANTHROPIC_API_KEY=
