# Optional but strongly recommended. A GitHub personal access token (no scopes
# needed for public repositories) raises the GitHub API rate limit from 60 to
# 5,000 requests/hour and lets Welwitschia analyze a much larger sample of
# each repository's commit history.
GITHUB_TOKEN=

# Optional. Enables the "Explain This Period" button, which sends a small
# summarized JSON payload (not source code or full commit data) to Tilvar,
# a self-hosted translation/chat model, for a plain-English explanation. The
# rest of the app works fully without this key.
WELWITSCHIA_TILVAR_API_KEY=

# Optional. Tilvar rejects requests over this many characters (HTTP 413).
# Only used as a known limit for the Tilvar API; defaults to 5000 if unset.
WELWITSCHIA_TILVAR_API_MAX_CHARS=5000
